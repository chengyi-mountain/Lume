# ============================================================
#  小白学习指南 · LearnEasy
#  AI 智能体接入配置（可选）
#  ----------------------------------------------------------------
#  这是一份配置模板。本站不依赖任何后端，也不需要真实的环境变量：
#  所有 AI 配置都在浏览器侧通过 window.LUME_STUDIO_CONFIG 读取。
#  这个文件的作用是：
#    1) 给自建部署的人一个填写清单；
#    2) 防止误把 .env 里的 Key 提交到公开仓库（已加入 .gitignore）。
#  ----------------------------------------------------------------
#  用法：复制本文件为 .env，填好值后，用构建脚本把它注入到
#  index.html 的 </body> 前。或者直接在 index.html 里手填。
# ============================================================

# ---- 基础配置（OpenAI 兼容格式）----
# 你的接口地址，例如：
#   混元：https://hunyuan.tencentcloudapi.com/v1/chat/completions
#   DeepSeek：https://api.deepseek.com/v1/chat/completions
#   OpenAI：https://api.openai.com/v1/chat/completions
LE_API_URL=

# 使用的模型名
LE_MODEL=

# 鉴权方式：填写完整请求头。常见的是 Bearer Token：
#   Bearer sk-xxxxxxxxxxxxxxxx
# 也可能是 ApiKey：  sk-xxxxxxxxxxxxxxxx
LE_AUTH_HEADER=

# 接口是否为 OpenAI 兼容格式（true / false）
LE_FORMAT_OPENAI=true

# ---- 进阶：自定义请求体 ----
# 如果你的接口不是 OpenAI 兼容格式，可以提供一个 bodyBuilder 函数。
# 直接在 index.html 里按下面的形式写：
#
#   window.LUME_STUDIO_CONFIG = {
#     api: LE_API_URL,
#     bodyBuilder: (name, prompt, cfg) => JSON.stringify({
#       model: cfg.model,
#       system: "你是学习助手",
#       input: prompt
#     })
#   };
#
# 自定义请求头同理，用 cfg.headers 覆盖。

# ---- 仓库地址（用于「提 issue / 提 PR」链接）----
# 格式：用户名/仓库名
LE_REPO=你的用户名/小白学习指南

# ============================================================
#  ⚠️ 安全提醒
#  ------------------------------------------------------------
#  1. 不要把填好 Key 的 .env 或 index.html 提交到公开仓库；
#  2. 自建部署建议使用低额度 / 受限的 Key，避免被滥用；
#  3. Key 只存在用户本地浏览器内存中，本项目不会上传、不会收集。
# ============================================================
